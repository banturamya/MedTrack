# Healthcare Management System (MedTrack) - Environment Configuration
# Copy this file to .env and update with your actual values

# ==================== FLASK CONFIGURATION ====================
FLASK_SECRET_KEY=your_secret_key_change_this_in_production
FLASK_ENV=development
FLASK_DEBUG=1

# ==================== EMAIL CONFIGURATION ====================
# For Gmail: Enable "Less secure app access" or use App Password
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# ==================== DATABASE CONFIGURATION ====================
# Options: memory (default), sqlite, postgresql, dynamodb
DATABASE_TYPE=memory
DATABASE_PATH=./medtrack.db

# ==================== AWS CONFIGURATION ====================
# Only required if using DynamoDB
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
USERS_TABLE=MedTrack_Users
APPOINTMENTS_TABLE=MedTrack_Appointments
NOTIFICATIONS_TABLE=MedTrack_Notifications

# ==================== POSTGRESQL CONFIGURATION ====================
# Only required if using PostgreSQL database
# DATABASE_URL=postgresql://username:password@localhost:5432/medtrack_db

# ==================== APPLICATION SETTINGS ====================
# Application port
FLASK_PORT=5000

# Application host
FLASK_HOST=0.0.0.0

# ==================== LOGGING SETTINGS ====================
LOG_LEVEL=INFO
LOG_FILE=app.log

# ==================== SECURITY SETTINGS ====================
# Session timeout in minutes
SESSION_TIMEOUT=30

# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# ==================== FEATURE FLAGS ====================
# Enable/disable email notifications
ENABLE_EMAIL_NOTIFICATIONS=true

# Enable/disable SMS notifications (future)
ENABLE_SMS_NOTIFICATIONS=false

# Enable/disable appointment reminders
ENABLE_APPOINTMENT_REMINDERS=true
